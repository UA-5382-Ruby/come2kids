#!/usr/bin/env ruby
# frozen_string_literal: true

# Starts Sidekiq with the project configuration.
# Usage: bin/jobs
# Equivalent to: bundle exec sidekiq -C config/sidekiq.yml

dir = File.expand_path("..", __dir__)
Dir.chdir(dir)

exec("bundle", "exec", "sidekiq", "-C", "config/sidekiq.yml", *ARGV)
