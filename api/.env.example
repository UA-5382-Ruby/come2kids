# Copy to .env for local (non-Docker) Rails: cp .env.example .env
# For Docker Compose, use the repo-root .env.example instead (service hostnames).
# Never commit .env.

# --- PostgreSQL ---
# DATABASE_URL=postgres://postgres:password@localhost:5432/come2kids_dev
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
# DB_NAME=come2kids_production

# --- Redis / Sidekiq ---
REDIS_URL=redis://localhost:6379/0
SIDEKIQ_CONCURRENCY=5
SIDEKIQ_USERNAME=sidekiq
SIDEKIQ_PASSWORD=sidekiq

# --- MongoDB (activity / failure logs) ---
MONGODB_URI=mongodb://localhost:27017/come2kids_development

# --- Mail (development → Mailpit) ---
MAIL_FROM=noreply@come2kids.local
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_DOMAIN=localhost
MAILER_DEFAULT_HOST=localhost
MAILER_DEFAULT_PORT=3000

# --- Mail (production SMTP; used by compose/prod) ---
# SMTP_ADDRESS=smtp.example.com
# SMTP_PORT=587
# SMTP_DOMAIN=example.com
# SMTP_USER_NAME=
# SMTP_PASSWORD=
# SMTP_AUTHENTICATION=plain
# SMTP_ENABLE_STARTTLS_AUTO=true
# APP_HOST=api.example.com
# APP_PROTOCOL=https

# --- Auth / CORS ---
FRONTEND_ORIGINS=http://localhost:3000
# JWT_SECRET=
# JWT_ISSUER=come2kids
# JWT_ACCESS_TTL=900

RAILS_MAX_THREADS=5

# --- Active Record encryption (required by Rails 8; override in production) ---
# ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
# ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
# ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=
