<h2 style="margin:0 0 16px;"><%= t(".greeting", name: @user.first_name) %></h2>
<p><%= t(".intro") %></p>
<p style="margin:24px 0;">
  <a href="<%= @reset_url %>"
     style="background:#dc2626;color:#ffffff;padding:12px 20px;border-radius:6px;text-decoration:none;display:inline-block;">
    <%= t(".button") %>
  </a>
</p>
<p style="font-size:13px;color:#555;">
  <%= t(".link_hint") %><br>
  <a href="<%= @reset_url %>"><%= @reset_url %></a>
</p>
<p style="font-size:13px;color:#555;"><%= t(".expires", hours: @expires_in_hours) %></p>
<p style="font-size:13px;color:#555;"><%= t(".ignore") %></p>