# Docker Compose — local development defaults.
# Copy: cp .env.example .env
# Then: docker compose up -d --build
#
# Compose auto-loads this file for ${VAR} substitution.
# Never commit .env.

# --- Rails ---
RAILS_ENV=production
RAILS_LOG_LEVEL=debug
SECRET_KEY_BASE=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# --- PostgreSQL (Compose service: db) ---
POSTGRES_USER=come2kids
POSTGRES_PASSWORD=come2kids
POSTGRES_DB=come2kids_development
# Solid Cache / Cable reuse primary DB in Compose
POSTGRES_CACHE_DB=come2kids_development
POSTGRES_CABLE_DB=come2kids_development
API_DATABASE_PASSWORD=come2kids

# Host ports published by compose.override.yaml
DB_PORT=5432
REDIS_PORT=6379
MONGO_PORT=27017
API_PORT=3000
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- Redis / Sidekiq ---
SIDEKIQ_USERNAME=sidekiq
SIDEKIQ_PASSWORD=sidekiq
SIDEKIQ_CONCURRENCY=5

# --- MongoDB (Compose service: mongo) ---
MONGODB_URI=mongodb://mongo:27017/come2kids_development

# --- Mail (Compose → Mailpit) ---
MAIL_FROM=noreply@come2kids.local
SMTP_ADDRESS=mailpit
SMTP_PORT=1025
SMTP_DOMAIN=localhost
SMTP_USER_NAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS_AUTO=false
APP_HOST=localhost
APP_PROTOCOL=http

# --- Active Record encryption (dev placeholders — change in real deploys) ---
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=Come2KidsDevPrimaryKeyChangeMe12
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=Come2KidsDevDeterministicKeyChg
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=Come2KidsDevKeyDerivationSalt12
