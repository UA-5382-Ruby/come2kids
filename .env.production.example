# Docker Compose — production template.
# Copy: cp .env.production.example .env.production
# Then: docker compose -f compose.yaml --env-file .env.production up -d --build
#
# Replace every placeholder before deploy. Never commit .env.production.

# --- Rails ---
RAILS_ENV=production
RAILS_LOG_LEVEL=info
SECRET_KEY_BASE=change-me-in-production-use-rails-secret

# --- PostgreSQL (Compose service: db) ---
POSTGRES_USER=come2kids
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=come2kids_production
POSTGRES_CACHE_DB=come2kids_production
POSTGRES_CABLE_DB=come2kids_production
API_DATABASE_PASSWORD=change-me-strong-password

# --- Redis / Sidekiq ---
SIDEKIQ_USERNAME=sidekiq
SIDEKIQ_PASSWORD=change-me-sidekiq-password
SIDEKIQ_CONCURRENCY=5

# --- MongoDB (Compose service: mongo) ---
MONGODB_URI=mongodb://mongo:27017/come2kids_production

# --- Mail (real SMTP) ---
MAIL_FROM=noreply@come2kids.local
SMTP_ADDRESS=smtp.example.com
SMTP_PORT=587
SMTP_DOMAIN=example.com
SMTP_USER_NAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS_AUTO=true
APP_HOST=api.example.com
APP_PROTOCOL=https

# --- Active Record encryption (generate unique values per environment) ---
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=Come2KidsProdPrimaryKeyChangeMe!!
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=Come2KidsProdDeterministic!!
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=Come2KidsProdSaltChangeMe!!!
